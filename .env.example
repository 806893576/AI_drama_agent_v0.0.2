# LLM client: fake | openai | deepseek
# If this is omitted and DEEPSEEK_API_KEY is configured, the app auto-selects deepseek.
LLM_CLIENT=fake

# OpenAI-compatible Chat Completions API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4.1-mini

# DeepSeek Chat Completions API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_STRUCTURED_MODEL=deepseek-chat
DEEPSEEK_REASON_MODEL=deepseek-reasoner

# Optional. Keep false if some prompts output JSON arrays.
LLM_FORCE_JSON_OBJECT=false

# Optional. Writes full rendered prompts, request summaries, raw outputs, parsed
# results, errors, and usage to storage/llm_traces.
LLM_TRACE_ENABLED=true

# Optional retry policy for transient API/network instability.
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=0.5

# Runtime storage
DRAMA_STORAGE_DIR=storage
